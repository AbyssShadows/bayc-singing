 /// The repository root (data files and the generated tables are found from here).
 pub fn repo_path(rel: &str) -> String {
+    // A copy of the binary shipped without the source tree (e.g. inside a Blender add-on) keeps
+    // its data next to itself: $CHIMERA_ROOT/<rel>, <exe dir>/<rel> or <exe dir>/data/<file>.
+    // Otherwise, as before, the source tree it was built from.
+    let mut candidates = Vec::new();
+    if let Ok(root) = std::env::var("CHIMERA_ROOT") {
+        candidates.push(std::path::PathBuf::from(root).join(rel));
+    }
+    if let Some(dir) = std::env::current_exe().ok().and_then(|e| e.parent().map(|d| d.to_path_buf())) {
+        candidates.push(dir.join(rel));
+        if let Some(name) = std::path::Path::new(rel).file_name() {
+            candidates.push(dir.join("data").join(name));
+        }
+    }
+    for p in candidates {
+        if p.exists() {
+            return p.to_string_lossy().into_owned();
+        }
+    }
     format!("{}/../../{rel}", env!("CARGO_MANIFEST_DIR"))
 }
 
